#!/bin/sh
# Comando para manejar a Angri. Uso: angri [estado|log [N]|vivo|parar|seguir|reiniciar]
DATOS=/var/lib/angri
case "${1:-estado}" in
  estado)    sudo -u angri /opt/angri/angri vivir --carpeta $DATOS --estado
             echo; systemctl is-active angri.service ;;
  log)       sudo journalctl -u angri -n "${2:-30}" --no-pager -o short ;;
  vivo)      sudo journalctl -u angri -f -o cat ;;
  parar)     echo "Guardando y parando..."; sudo systemctl stop angri.service; sudo journalctl -u angri -n 2 --no-pager -o cat ;;
  seguir)    sudo systemctl start angri.service; echo "Angri sigue viviendo." ;;
  reiniciar) sudo systemctl restart angri.service; sudo journalctl -u angri -n 5 --no-pager -o cat ;;
  *)         echo "Uso: angri [estado|log [N]|vivo|parar|seguir|reiniciar]" ;;
esac
