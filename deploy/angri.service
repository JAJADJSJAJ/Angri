# Angri viviendo sola en el i5 (etapa 12b). Lo instala deploy/instalar.sh.
[Unit]
Description=Angri - vida continua
After=local-fs.target

[Service]
Type=simple
User=angri
Group=angri
WorkingDirectory=/var/lib/angri
Environment=ANGRI_DATOS=/var/lib/angri
ExecStart=/opt/angri/angri vivir
Restart=always
RestartSec=10
# Al parar (o al reinicio de las 05:30) systemd manda SIGTERM: Angri termina
# el tick, guarda (unos MB, menos de 1 s) y sale. Margen de sobra.
KillSignal=SIGTERM
TimeoutStopSec=120
# Toda la PC es suya: sin Nice ni topes. Usa 1 núcleo; los otros 3 quedan
# para mediciones (angri comparar ... -j 3) o etapas futuras.
# Solo puede escribir en su carpeta
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/angri

[Install]
WantedBy=multi-user.target
