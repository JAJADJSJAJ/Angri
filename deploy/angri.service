# Angri viviendo sola (etapa 12b). Ver README, "Etapa 12b: vivir en Linux".
# Como servicio de usuario: copiar a ~/.config/systemd/user/angri.service
# Como servicio de sistema: copiar a /etc/systemd/system/angri.service y
#   descomentar User= (y poner el usuario normal, nunca root).
# En ambos casos ajustar WorkingDirectory a la carpeta del repo.
[Unit]
Description=Angri: vida continua
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Angri
#User=angri
ExecStart=/usr/bin/python3 -u vivir.py
Restart=always
RestartSec=10
# Al parar, systemd manda SIGTERM: Angri termina el tick, guarda y sale.
KillSignal=SIGTERM
TimeoutStopSec=60
Nice=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
